   "description": "Price and cost fields with a pound prefix.",
   "html": "<label class=\"ds-field\"><span>New price per unit</span><span class=\"ds-money\"><i>\u00a3</i><input value=\"2.29\"></span></label>",
   "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font:500 13px Geist,system-ui,sans-serif;color:var(--ink-2,#474744)}.ds-money{position:relative;display:block}.ds-money i{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-style:normal;color:var(--ink-3,#6b6b67)}.ds-money input{height:40px;width:160px;padding:0 12px 0 28px;border:1px solid var(--rule-2,#c9c9c3);background:#fff;color:var(--ink,#111);font:400 14px Geist,system-ui,sans-serif;font-variant-numeric:tabular-nums;border-radius:0}.ds-money input:hover{border-color:var(--ink-3,#6b6b67)}.ds-money input:focus{outline:none;border-color:var(--ink,#111)}"
