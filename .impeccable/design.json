 "narrative": {
  "northStar": "A price is a range, not a number",
  "overview": "saka is a Swiss-grid working screen: ink on paper, hairline rules, square shapes, one signal red. Every forecast is a range bar whose red tick is the likely value; earlier ranges stay as fading lines so the seller sees uncertainty narrow. Motion steps in two frames; charts step week by week.",
  "keyCharacteristics": [
   "Range bar on every forecast",
   "One red for likely value and test price",
   "Hairlines instead of cards",
   "Stepped motion and stepped charts",
   "Tabular figures everywhere",
   "PayPal refusals shown verbatim"
  ],
  "rules": [
   {
    "name": "The One Red Rule",
    "body": "Red marks the likely value and the price under test. Nothing decorative is red.",
    "section": "colors"
   },
   {
    "name": "Hairlines, not boxes",
    "body": "Sections open with a 1px ink rule; rows split with 1px rule. No cards, no shadows.",
    "section": "elevation"
   },
   {
    "name": "No kickers",
    "body": "No eyebrow labels above titles; context lives in the sentence under the title.",
    "section": "typography"
   }
  ],
  "dos": [
   "Draw every forecast as a range bar",
   "Keep earlier ranges visible as ghosts",
   "Quote PayPal's refusal inline",
   "Label simulated shoppers separately"
  ],
  "donts": [
   "Rounded corners, shadows, gradients or blur",
   "Eased motion",
   "Smooth curves for sales data",
   "Eyebrow labels, emoji icons, thick coloured left borders"
  ]
 }
}