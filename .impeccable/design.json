  {
   "name": "Range Bar",
   "kind": "custom",
   "refersTo": "range-bar",
   "description": "The signature: low-to-high ink bar, red likely tick, hollow today tick, fading earlier ranges.",
   "html": "<div class=\"ds-range\"><b class=\"ds-mid-label\">\u00a35,411</b><div class=\"ds-axis\"></div><div class=\"ds-bar\"></div><div class=\"ds-g1\"></div><div class=\"ds-g2\"></div><div class=\"ds-base\"></div><div class=\"ds-mid\"></div><span class=\"ds-lo\">\u00a35,098</span><span class=\"ds-hi\">\u00a35,739</span></div>",
   "css": ".ds-range{position:relative;height:76px;width:320px;font:400 12px Geist,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-axis{position:absolute;left:0;right:0;top:30px;height:1px;background:var(--rule-2,#c9c9c3)}.ds-bar{position:absolute;top:26px;height:9px;left:20%;width:62%;background:var(--ink,#111)}.ds-g1,.ds-g2{position:absolute;height:1px;background:var(--ghost,#bdbdb7)}.ds-g1{top:41px;left:8%;width:84%;opacity:.5}.ds-g2{top:38px;left:14%;width:72%;opacity:1}.ds-base{position:absolute;top:22px;height:17px;width:7px;left:12%;transform:translateX(-50%);border:2px solid var(--ink,#111);background:#fff;box-sizing:border-box}.ds-mid{position:absolute;top:20px;height:21px;width:3px;left:48%;transform:translateX(-50%);background:var(--red,#e1001f)}.ds-mid-label{position:absolute;top:0;left:48%;transform:translateX(-50%);font-size:13px;font-weight:600;color:var(--red-ink,#b80019)}.ds-lo,.ds-hi{position:absolute;top:54px;transform:translateX(-50%);color:var(--ink-3,#6b6b67)}.ds-lo{left:20%}.ds-hi{left:82%}"
