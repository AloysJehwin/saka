# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the app's webhook settings, used to verify signatures
PAYPAL_WEBHOOK_ID=
# Same client ID, exposed to the browser for the PayPal JavaScript SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Only needed if your key is not scoped to a workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Local SQLite file
DATABASE_PATH=./data/saka.db

# Sign-in (Better Auth): generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Web). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: an existing Gift Box Club plan (otherwise create it from the Apply screen)
PAYPAL_CLUB_PLAN_ID=
# Local only: email sign-in for testing before the OAuth apps exist. Ignored in production.
SAKA_DEV_LOGIN=
