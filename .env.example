# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the app's webhook settings, used to verify signatures
PAYPAL_WEBHOOK_ID=
# Same client ID, exposed to the browser for the PayPal JavaScript SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Local SQLite file
DATABASE_PATH=./data/saka.db
